{
  "name": "dsh-boot-video-manager",
  "version": "1.3.1",
  "description": "DSH 开屏动画的配套插件：管理开屏视频播放列表（顺序/随机/单次），带开屏声音开关和音频自检状态条，并会自动补好旧版动画插件「开机第一次没声音」的修复。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "boot-animation",
    "splash-screen",
    "audio",
    "cold-start"
  ],
  "license": "MIT",
  "author": "Firefly-TheHerta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firefly-TheHerta/dsh-boot-video-manager.git"
  },
  "homepage": "https://github.com/Firefly-TheHerta/dsh-boot-video-manager#readme",
  "bugs": {
    "url": "https://github.com/Firefly-TheHerta/dsh-boot-video-manager/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "tools/install.ps1",
    "tools/uninstall.ps1",
    "tools/autoplay-on.ps1"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
